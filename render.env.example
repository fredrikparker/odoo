# Render backend (Odoo) env vars. Replace all dummy values before deployment.
DB_HOST=db.your-supabase-url.supabase.co
DB_PORT=5432
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=strong_password

AWS_ACCESS_KEY_ID=blackbear_access_key
AWS_SECRET_ACCESS_KEY=blackbear_secret
AWS_REGION=us-east-1
S3_ENDPOINT=https://s3.blackbear.example.com
S3_BUCKET=my-bucket

# Odoo settings
ADMIN_PASSWORD=change_me_master_password
ODOO_PROXY_MODE=False
ODOO_HTTP_PORT=8069
